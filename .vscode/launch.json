    "version": "0.2.0",
    "configurations": [
        {
        "name": "Launch CortexEngine (MSVC)",
        "type": "cppvsdbg",
        "request": "launch",
        "program": "${workspaceFolder}/CortexEngine/build/bin/CortexEngine.exe",
        "args": [],
        "cwd": "${workspaceFolder}/CortexEngine/build/bin",
        "console": "integratedTerminal",
        "stopAtEntry": false
        },
        {
            "name": "Attach to Chrome",
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}"
        }

    ]
}