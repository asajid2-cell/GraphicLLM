{
  "schema": "cortex.full_scene_shader_pipeline_v3.contract.v1",
  "purpose": "Ground the FullSceneShaderPipeline V3 refactor in named render-graph resources, debug views, frame-report evidence, and packet gates before beauty promotion.",
  "status": "planned_not_promoted",
  "promotion_rule": "No V3 domain may affect default beauty until its producer resource, consumer path, debug view, frame-report fields, packet analyzer, and contact sheet evidence pass on the required stress families.",
  "required_scene_families": [
    "gallery",
    "kitchen",
    "office",
    "gym",
    "concert",
    "red_room",
    "stadium"
  ],
  "domains": {
    "render_graph": {
      "owner": "FullSceneShaderPipelineV3",
      "required_outputs": [
        "material_attributes",
        "direct_lighting",
        "indirect_lighting",
        "shadow_visibility",
        "shadow_loss",
        "lighting_energy_budget",
        "shadow_source_attribution",
        "reflection_radiance",
        "reflection_confidence",
        "reflection_source_id",
        "reflection_rejected_source_mask",
        "reflection_temporal_delta",
        "reflection_ssr_source_signal",
        "reflection_rt_source_signal",
        "reflection_source_suppression",
        "reflection_history_v3_curr",
        "reflection_history_v3_prev",
        "reflection_history_v3_prev_source_id",
        "reflection_history_v3_validity",
        "reflection_history_v3_rejection",
        "scene_local_environment",
        "hdr_scene_color",
        "candidate_hdr_scene_color",
        "energy_clamp_policy",
        "overbright_diagnostics",
        "composite_contribution_map",
        "legacy_rescue_usage",
        "ldr_cinematic_output",
        "candidate_ldr_cinematic_output"
      ],
      "required_contract_fields": [
        "resource_owner",
        "producer_pass",
        "consumer_passes",
        "debug_view_id",
        "default_beauty_affects",
        "packet_gate"
      ]
    },
    "material": {
      "producer": "FullSceneMaterialResolveV3",
      "output_resource": "material_attributes",
      "output_contract": "aggregate_over_visibility_buffer_material_resolve_outputs",
      "required_backing_resources": [
        "vb_gbuffer_albedo",
        "vb_gbuffer_normal_roughness",
        "vb_gbuffer_emissive_metallic",
        "vb_gbuffer_material_ext0",
        "vb_gbuffer_material_ext1",
        "vb_gbuffer_material_ext2"
      ],
      "required_channels": [
        "base_color",
        "roughness",
        "metallic",
        "normal",
        "ambient_occlusion",
        "emissive",
        "opacity",
        "transmission",
        "clearcoat",
        "sheen",
        "anisotropy",
        "ior",
        "thickness",
        "material_class"
      ],
      "required_debug_views": [
        "material_base_color",
        "material_roughness",
        "material_metallic",
        "material_normal",
        "material_class",
        "material_missing_channel_mask"
      ],
      "packet_debug_views": [
        "material_base_color",
        "material_normal",
        "material_missing_channel_mask",
        "roughness",
        "metallic",
        "surface_class",
        "surface_policy",
        "material_family",
        "reflection_policy",
        "temporal_policy",
        "post_sensitivity",
        "material_id",
        "object_id"
      ]
    },
    "lighting": {
      "producer": "FullSceneLightingV3",
      "adapter_producer": "FullSceneLightingV3Adapter",
      "adapter_output_resource": "hdr_color",
      "adapter_owner": "VBDeferredLighting",
      "adapter_status": "instrumented_not_split",
      "required_light_types": [
        "directional",
        "point",
        "spot",
        "rect_area",
        "emissive_mesh",
        "scene_local_ambient"
      ],
      "required_outputs": [
        "direct_lighting",
        "direct_lighting_unshadowed",
        "shadow_visibility",
        "shadow_loss",
        "indirect_lighting",
        "lighting_energy_budget",
        "shadow_source_attribution"
      ],
      "current_adapter_debug_views": [
        "VB_DeferredDirectLight",
        "VB_DeferredDirectLightUnshadowed",
        "VB_DeferredDirectLightShadowLoss",
        "VB_DeferredShadowFactor",
        "VB_DeferredAmbientIBL"
      ],
      "required_debug_views": [
        "direct_light",
        "direct_light_unshadowed",
        "shadow_visibility",
        "shadow_loss",
        "indirect_light",
        "lighting_energy_budget",
        "shadow_source_attribution",
        "lighting_overbright",
        "lighting_underlit"
      ]
    },
    "reflection": {
      "producer": "FullSceneReflectionV3",
      "required_sources": [
        "local_reflection_radiance",
        "screen_space_reflection",
        "ray_query_reflection",
        "local_probe",
        "scene_local_environment"
      ],
      "required_resolver_inputs": [
        "local_reflection_radiance",
        "ssr_color",
        "rt_reflection",
        "reflection_history_v3_prev_source_id",
        "reflection_history_v3_validity",
        "reflection_history_v3_rejection",
        "normal_roughness",
        "vb_gbuffer_emissive_metallic",
        "vb_gbuffer_material_ext2"
      ],
      "required_history_inputs": [
        "reflection_radiance",
        "reflection_source_id",
        "reflection_temporal_delta",
        "reflection_history_v3_prev",
        "reflection_history_v3_prev_source_id",
        "depth",
        "normal_roughness",
        "velocity"
      ],
      "required_outputs": [
        "reflection_radiance",
        "reflection_confidence",
        "reflection_source_id",
        "reflection_rejected_source_mask",
        "reflection_temporal_delta",
        "reflection_ssr_source_signal",
        "reflection_rt_source_signal",
        "reflection_source_suppression",
        "reflection_history_v3_curr",
        "reflection_history_v3_prev",
        "reflection_history_v3_prev_source_id",
        "reflection_history_v3_validity",
        "reflection_history_v3_rejection"
      ],
      "required_debug_views": [
        "reflection_radiance",
        "reflection_confidence",
        "reflection_source_id",
        "reflection_temporal_delta",
        "reflection_rejected_source_mask",
        "reflection_ssr_source_signal",
        "reflection_rt_source_signal",
        "reflection_source_suppression",
        "reflection_history_v3_curr",
        "reflection_history_v3_prev",
        "reflection_history_v3_validity",
        "reflection_history_v3_rejection"
      ]
    },
    "environment": {
      "producer": "SceneLocalEnvironmentV3",
      "required_modes": [
        "enclosed_room",
        "open_exterior",
        "stage",
        "neutral_lab"
      ],
      "required_outputs": [
        "scene_local_environment",
        "ambient_lighting",
        "visible_background",
        "reflection_background",
        "atmosphere"
      ],
      "required_debug_views": [
        "environment_mode",
        "ambient_lighting",
        "reflection_background",
        "visible_background",
        "atmosphere"
      ],
      "packet_debug_views": [
        "scene_local_environment",
        "ambient_lighting",
        "visible_background",
        "reflection_background",
        "atmosphere"
      ]
    },
    "composite": {
      "producer": "FullSceneCompositeV3",
      "adapter_producer": "FullSceneCompositeV3Adapter",
      "adapter_output_resource": "hdr_color",
      "required_inputs": [
        "material_attributes",
        "direct_lighting",
        "indirect_lighting",
        "vb_gbuffer_albedo",
        "reflection_radiance",
        "reflection_confidence",
        "scene_local_environment"
      ],
      "required_outputs": [
        "hdr_scene_color",
        "candidate_hdr_scene_color",
        "energy_clamp_policy",
        "overbright_diagnostics",
        "composite_contribution_map",
        "legacy_rescue_usage"
      ],
      "required_debug_views": [
        "hdr_scene_color",
        "candidate_hdr_scene_color",
        "energy_clamp_mask",
        "overbright_mask",
        "composite_contribution_map",
        "legacy_rescue_usage"
      ]
    },
    "cinematic_post": {
      "producer": "CinematicPostV3",
      "required_stages": [
        "filmic_tonemap",
        "exposure",
        "bloom",
        "color_grade",
        "depth_of_field",
        "sharpen"
      ],
      "required_debug_views": [
        "hdr_scene_color",
        "candidate_hdr_scene_color",
        "exposure_meter",
        "bloom_extract",
        "color_grade_delta",
        "ldr_cinematic_output",
        "candidate_ldr_cinematic_output"
      ]
    },
    "candidate_beauty": {
      "producer": "CinematicPostV3",
      "legacy_bridge_producer": "FullSceneCandidateBeautyV3",
      "adapter_producer": "FullSceneCandidateBeautyV3Adapter",
      "status": "opt_in_not_default",
      "required_inputs": [
        "candidate_hdr_scene_color",
        "scene_local_environment",
        "reflection_radiance",
        "lighting_split"
      ],
      "rejected_ready_inputs": [
        "hdr_color",
        "ldr_cinematic_output"
      ],
      "required_outputs": [
        "candidate_ldr_cinematic_output"
      ],
      "required_debug_views": [
        "candidate_beauty_v3",
        "hdr_scene_color",
        "ldr_cinematic_output"
      ],
      "promotion_rule": "candidate_beauty may be captured and ranked only when default_beauty_affects remains false and the ready path is CinematicPostV3(candidate_hdr_scene_color -> candidate_ldr_cinematic_output); legacy hdr_color bridges are diagnostic debt, not ready candidates"
    },
    "validation": {
      "required_artifacts": [
        "frame_report_shutdown.json",
        "debug_view_metrics.json",
        "v3_material_payload.json",
        "v3_signal.json",
        "v3_stability.json",
        "contact_sheet.png",
        "promotion_decision.md"
      ],
      "required_gates": [
        "no_missing_required_resource",
        "no_missing_required_material_channel",
        "material_payload_debug_views_present",
        "material_payload_ranges_valid",
        "lighting_signal_nonzero",
        "shadow_visibility_stable",
        "reflection_confidence_nonzero",
        "reflection_temporal_delta_bounded",
        "environment_mode_matches_scene",
        "post_exposure_not_clipped",
        "default_beauty_unchanged_until_promotion"
      ]
    }
  }
}
